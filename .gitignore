# Loose root-level samplesheets only — `datasets/<ds>/samplesheets/sample_metadata.csv`
# is the canonical tracked location.
datasets/*/sample_metadata.csv
IMPLEMENTATION_GUIDE.md

# PerturbNMF / cNMF outputs (large; HPC-only). The capital-S/D/R subdir convention is
# preserved when PerturbNMF/ moves to datasets/<ds>/<run>/cnmf/<cnmf_run>/ — keep these ignored.
# Track Script/ + README.md + lightweight selection plots; ignore the bulk Data/ + Result/ trees.
**/PerturbNMF/Data/
**/PerturbNMF/Result/
**/cnmf/**/Data/
**/cnmf/**/Result/
external/PerturbNMF/

# Per-run CRISPR pipeline outputs (large, regenerable from GCP).
# Replaces the prior top-level `runs/` rule now that pipeline outputs live at
# datasets/<ds>/<run>/crispr_pipeline/{pipeline_outputs,pipeline_dashboard,anndata,tf,work}/
datasets/*/*/crispr_pipeline/pipeline_outputs/
datasets/*/*/crispr_pipeline/pipeline_dashboard/
datasets/*/*/crispr_pipeline/anndata/
datasets/*/*/crispr_pipeline/tf/
datasets/*/*/crispr_pipeline/work/

# Jamboree mirror logs (HPC-only, ephemeral)
docs/jamborees/**/mirror_*.log

