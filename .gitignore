# Large reference data files (downloadable on demand, not source-controlled)
ref/genome/hg38.fa
ref/genome/hg38.fa.fai
ref/genome/Homo_sapiens.GRCh38.113.gtf
ref/genome/IGVFFI9573KOZR.gtf.gz
ref/guide_libraries/weissman_guides_with_coordinates.tsv
ref/motifs/hocomoco_meme.meme
ref/motifs/motifs.meme
ref/enhancer_gene/scE2G_links/
ref/gene_sets/GO_Biological_Process_2023_human.json
ref/gene_sets/Reactome_2022_human.json
ref/opentargets/OpenTargets_L2G_Filtered.csv.gz
ref/opentargets/OpenTargets_L2G_noQC.csv.gz

# Calibration result TSVs — regenerable, large (some >100MB). Calibration is its own
# analysis tier (datasets/<ds>/<run>/calibration/), not inside crispr_pipeline/. Keep both
# patterns during the migration in case any are still under the old path.
**/calibration/*_calibrated_*_results.tsv
**/crispr_pipeline/calibration/*_calibrated_*_results.tsv

# Large pipeline output files (>50 MB; GitHub 100 MB limit)
**/*.h5ad
**/perturbo_*_per_*_output.tsv.gz
**/pipeline_qc/trans/*_trans_results.tsv
# Top-level Nextflow canonical outputs (cis/trans per element/guide) — same scale as the
# perturbo outputs above but without the `perturbo_` prefix; e.g.
# datasets/<ds>/<run>/crispr_pipeline/trans_per_guide_results.tsv.gz at 2.3 GB
**/crispr_pipeline/*_per_*_results.tsv.gz

# Energy distance: keep configs (.json) + scripts; ignore the result outputs
**/energy_distance/*.csv
**/energy_distance/*.tsv
**/energy_distance/*.pickle
**/energy_distance/image/
**/energy_distance/logs/

# QC analysis-tier outputs: scripts/configs stay tracked; plots + result tables are large
**/qc/**/*.png
**/qc/**/*.pdf
**/qc/**/*.tsv
**/qc/**/*.h5ad

# Nextflow auto-generated pipeline_qc/ and pipeline_comparisons/ (alongside pipeline_outputs/)
**/crispr_pipeline/pipeline_qc/
**/crispr_pipeline/pipeline_comparisons/
